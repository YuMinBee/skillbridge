# 복사해서 .env 로 쓰세요 (Windows: copy .env.example .env). .env는 커밋 금지.
AWS_PROFILE=kosa
AWS_REGION=ap-northeast-2

# 1 = Bedrock 호출 없이 규칙/템플릿으로 동작 (시연·오프라인 기본값)
BEDROCK_MOCK=1
# live = 공공데이터 API 수집 결과 사용(M3), sample = seed/ 샘플
DATA_MODE=sample

# 팀 계정에서 접근 확인된 모델 ID (교육 노트북 00_환경점검 2-1 통과 값)
MODEL_ID=global.anthropic.claude-sonnet-4-6
FAST_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# 설명 생성 모델 (비우면 FAST_MODEL_ID)
EXPLAIN_MODEL_ID=
# Bedrock Knowledge Base ID (M4)
KB_ID=
# Guardrail (M2)
GUARDRAIL_ID=
GUARDRAIL_VERSION=

# 공공데이터포털 일반 인증키 (M3)
DATA_GO_KR_API_KEY=

# 고용24 OPEN-API 인증키 (M3) — 고용24 마이페이지 목록 순서. 채팅·커밋 금지
# 1. 채용정보 (개인회원: 채용행사·공채속보·공채기업정보만 가능)
WORK24_KEY_RECRUIT=
# 2. 국민내일배움카드 훈련과정
WORK24_KEY_TRAINING=
# 3. 직무정보
WORK24_KEY_JOB=
# 4. 공통코드
WORK24_KEY_CODE=
# 5. 국가인적자원개발 컨소시엄 훈련과정
WORK24_KEY_CONSORTIUM=

# 잡알리오(공공기관 채용정보) 오픈API 인증키 (M3) — opendata.alio.go.kr
ALIO_API_KEY=
